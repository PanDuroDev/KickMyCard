{
  "manifest_version": 3,
  "name": "KickMyCard",
  "version": "1.0.0",
  "description": "Hides Anime3rb anti-adblock dialogs and invisible full-screen ad overlays.",
  "content_scripts": [
    {
      "matches": [
        "https://anime3rb.com/*",
        "https://www.anime3rb.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
